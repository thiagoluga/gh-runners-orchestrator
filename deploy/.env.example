# Copy to .env next to compose.yaml. Nothing secret goes here.
# Orchestrator image tag: a sha-<commit> tag from GHCR (or main for the latest build of main).
ORCHESTRATOR_TAG=main
# stat -c %g /var/run/docker.sock
DOCKER_GID=988
# Where the App private key lives on the host (mode 0400, owner 1654).
GITHUB_APP_KEY_FILE=/etc/gh-runners-orchestrator/github-app.pem
# Host loopback port of the status endpoint (/healthz, /metrics).
STATUS_PORT=9464
