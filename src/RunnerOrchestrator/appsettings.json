{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Orchestrator": {
    "PollInterval": "00:00:20",
    "DockerSocket": "/var/run/docker.sock",
    "GitHubApp": {
      "PrivateKeyPath": "/run/secrets/github-app.pem"
    }
  }
}
